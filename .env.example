# SGA - Variáveis de Ambiente de Exemplo (.env.example)
# NUNCA insira senhas ou chaves reais neste arquivo ou versione arquivos .env no Git!

# Porta de Execução do Backend
PORT=3001
NODE_ENV=development

# Configuração do Supabase (Nuvem)
# Obtenha estas informações no painel do Supabase -> Project Settings -> API
SUPABASE_URL=https://exemplo-seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta-aqui
SUPABASE_ANON_KEY=sua-anon-key-publica-aqui

# Configuração do Banco de Dados PostgreSQL Local (Opcional caso use Docker)
DATABASE_URL=postgres://sga_user:sga_secure_password@localhost:5432/sga_db
